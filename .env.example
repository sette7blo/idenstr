# Copy to .env and edit locally. Do not commit .env.

# Your Nostr identity. Both are required.
# No signer/NIP-46 and no Docker-secret key mode: same-host signers are redundant here.
IDENSTR_KEY_MODE=env_nsec
IDENSTR_NPUB=
IDENSTR_NSEC=

# Host port (default: 3000)
IDENSTR_HOST_PORT=3000

# Default relays for initial onboarding (comma-separated).
IDENSTR_DEFAULT_READ_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
IDENSTR_DEFAULT_WRITE_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
