# Copy to .env and edit locally. Do not commit .env.

# Your Nostr identity. Both are required.
# IDENSTR_NPUB is also the owner key the private relay pins writes to: the vault
# accepts only events signed by this identity.
# No signer/NIP-46 and no Docker-secret key mode: same-host signers are redundant here.
IDENSTR_KEY_MODE=env_nsec
IDENSTR_NPUB=
IDENSTR_NSEC=

# Optional: connect a lightning wallet over Nostr Wallet Connect (NIP-47) for the
# Wallet section. This is a spending credential — treat it like IDENSTR_NSEC. Set
# it from the dashboard (Wallet → Save connection) or paste the full string here.
# IDENSTR_NWC_URI=nostr+walletconnect://<wallet-pubkey>?relay=wss://...&secret=<hex>
IDENSTR_NWC_URI=

# Host port/bind address. IDENSTR_HOST_BIND controls Docker's host-side binding.
# Default is 0.0.0.0 so the dashboard and linked apps are reachable over your
# LAN or Tailscale/WireGuard mesh. Set it to 127.0.0.1 for a local-only install.
IDENSTR_HOST_PORT=3000
IDENSTR_HOST_BIND=0.0.0.0

# Dashboard access is intentionally open on your trusted server/LAN/mesh. Other
# *str apps authenticate with scoped bearer tokens, not dashboard credentials.
# If you expose Idenstr beyond a trusted network, put it behind your reverse proxy
# or VPN access layer instead of reintroducing in-app username/password prompts.

# Optional admin bearer token for scripts/curl:
IDENSTR_ADMIN_TOKEN=change-me-long-random-admin-token

# Private relay (the embedded Strfry write-ahead vault). One URL is the single
# source of truth: Idenstr writes its own vault here, advertises it to your other
# *str apps, and prefills it in the dashboard. Writes are pinned to IDENSTR_NPUB,
# so only Idenstr can write; it is read-reachable by linked apps.
#
# LAN by default: the relay port publishes on 0.0.0.0 so apps on other hosts can
# reach it, and the advertised URL is ws://<LAN_IP>:7777. Run
# scripts/detect-lan-ip.sh once to fill IDENSTR_LAN_IP and the URL automatically,
# or set them by hand. Editing the URL in the dashboard rewrites it here (so make
# .env writable by the container user: chmod 660 .env), then recreate the
# container (docker compose up -d) to apply.
IDENSTR_LAN_IP=
IDENSTR_PRIVATE_RELAY_URL=ws://private-relay:7777
IDENSTR_PRIVATE_RELAY_BIND=0.0.0.0
IDENSTR_PRIVATE_RELAY_PORT=7777

# Default relays for initial onboarding (comma-separated).
IDENSTR_DEFAULT_READ_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
IDENSTR_DEFAULT_WRITE_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
