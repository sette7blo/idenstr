# Copy to .env and edit locally. Do not commit .env.

# Host ports are bound to 0.0.0.0 by default.
IDENSTR_HOST_BIND=0.0.0.0
IDENSTR_HOST_PORT=3000
IDENSTR_PRIVATE_RELAY_HOST_PORT=8081

# Development-only placeholder. Replace before real use.
IDENSTR_DB_PASSWORD=change-me

# Key custody mode:
# - env_nsec: canonical and only Idenstr mode; nsec is read from IDENSTR_NSEC in this .env file
# No signer/NIP-46 and no Docker-secret key mode for this project: same-host signers are redundant here.
IDENSTR_KEY_MODE=env_nsec
IDENSTR_NPUB=
IDENSTR_NSEC=

# Relay defaults. Comma-separated list for initial onboarding defaults.
IDENSTR_DEFAULT_READ_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
IDENSTR_DEFAULT_WRITE_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net

# Private relay/vault URL inside compose network.
IDENSTR_PRIVATE_RELAY_URL=ws://private-relay:8080

# Backups
IDENSTR_BACKUP_DIR=/app/backups
IDENSTR_REQUIRE_ENCRYPTED_SECRET_BACKUPS=true
